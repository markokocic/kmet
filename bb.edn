{:min-bb-version "1.12.215"
 :paths ["src" "test"]
 :deps {dev.weavejester/cljfmt {:mvn/version "0.16.5"}}
 :tasks
 {run     {:doc "Run kmet (interactive TUI)"
           :requires ([kmet.core :as core])
           :task (apply core/-main *command-line-args*)
           :override-builtin true}
  test    {:doc "Run fast test suites (excludes ^:slow tests). Args: test var names (plain name or ns/var) to run only those, e.g. `bb test test-tool-bash`."
           :requires ([kmet.runner :as runner])
           :task (apply runner/-main false *command-line-args*)
           :override-builtin true}
  test-ext {:doc "Run ONLY the slow (^:slow) test suites. Args: test var names to run only those (final validation before commit)"
           :requires ([kmet.runner :as runner])
           :task (apply runner/-main true *command-line-args*)
           :override-builtin true}
  changed {:doc "List files changed since the last commit (git; mtime-since-baseline fallback without git)"
           :requires ([kmet.changed :as changed])
           :task (doseq [f (changed/changed-files)] (println f))}
  changed-baseline {:doc "Record 'all gates green as of now' for the mtime fallback (no-op with git); run after a full validation"
                    :requires ([kmet.changed :as changed])
                    :task (do (changed/mark-validated!)
                              (println "Changed-files baseline updated."))}
  test-changed {:doc "Run the non-slow tests of namespaces affected by changed files (require-graph closure). Full gate: bb test"
                :requires ([kmet.changed :as changed] [kmet.runner :as runner])
                :task (let [nss (changed/affected-test-nss)]
                        (if (seq nss)
                          (runner/run-ns-syms nss false)
                          (println "No affected test namespaces — nothing to run.")))}
  test-ext-changed {:doc "Run ONLY the slow (^:slow) tests of namespaces affected by changed files. Full gate: bb test-ext"
                    :requires ([kmet.changed :as changed] [kmet.runner :as runner])
                    :task (let [nss (changed/affected-test-nss)]
                            (if (seq nss)
                              (runner/run-ns-syms nss true)
                              (println "No affected test namespaces — nothing to run.")))}
  lint-changed {:doc "Lint changed files plus affected dependents (full gate: bb lint; lints everything when .clj-kondo changed)"
                :requires ([kmet.changed :as changed] [babashka.process :as p])
                :task (let [config? (changed/config-changed?)
                            paths (if config? (changed/all-clj-files) (changed/affected-lint-files))]
                        (if (seq paths)
                          (do (when config? (println "clj-kondo config/hooks changed — linting all files."))
                              (apply p/shell "clj-kondo" "--lint" paths))
                          (println "No changed files to lint.")))}
  format-changed {:doc "Format changed files in place (full gate: bb format)"
                  :requires ([kmet.changed :as changed] [cljfmt.tool :as fmt])
                  :task (let [paths (changed/changed-clj-files)]
                          (if (seq paths)
                            (fmt/fix {:paths paths})
                            (println "No changed files to format.")))}
  format-check-changed {:doc "Check formatting of changed files (full gate: bb format-check)"
                        :requires ([kmet.changed :as changed] [cljfmt.tool :as fmt])
                        :task (let [paths (changed/changed-clj-files)]
                                (if (seq paths)
                                  (fmt/check {:paths paths})
                                  (println "No changed files to check.")))}
  nrepl  {:doc "Start nREPL server for interactive development"
          :task (do (require 'babashka.nrepl.server)
                    (println "Starting nREPL on port 1667...")
                    (babashka.nrepl.server/start-server! {:port 1667})
                    (println "nREPL started on port 1667")
                    (deref (promise)))} ;; block forever
  check   {:doc "Verify all code compiles"
           :requires ([kmet.core])
           :task (println "All source namespaces compile successfully.")
           :override-builtin true}
  generate-models {:doc "Regenerate provider model catalogs from models.dev (network)"
                   :task (do (load-file "scripts/generate_models.clj")
                             ((ns-resolve 'generate-models '-main)))}
  generate-image-models {:doc "Regenerate the image model catalog from OpenRouter (network)"
                         :task (do (load-file "scripts/generate_image_models.clj")
                                   ((ns-resolve 'generate-image-models '-main)))}
  check-model-data {:doc "Offline validation of committed provider catalogs + manifest"
                    :task (let [errors (do (load-file "scripts/generate_models.clj")
                                           ((ns-resolve 'generate-models 'validate-committed!)))]
                            (if (seq errors)
                              (do (println "Invalid model data:")
                                  (doseq [e errors] (println "  -" e))
                                  (System/exit 1))
                              (println "Committed model data is valid.")))}
  lint    {:doc "Lint src/test with clj-kondo (optionally: specific files/dirs)"
           :requires ([babashka.process :as p])
           :task (let [paths (if (seq *command-line-args*)
                               *command-line-args*
                               ["src" "test"])]
                   (apply p/shell "clj-kondo" "--lint" paths))}
  format  {:doc "Format src/test with cljfmt (fix in place; optionally: specific files/dirs)"
           :requires ([cljfmt.tool :as fmt])
           :task (let [paths (if (seq *command-line-args*)
                               *command-line-args*
                               ["src" "test"])]
                   (fmt/fix {:paths paths}))}
  format-check {:doc "Check src/test formatting with cljfmt (no changes; optionally: specific files/dirs)"
                :requires ([cljfmt.tool :as fmt])
                :task (let [paths (if (seq *command-line-args*)
                                    *command-line-args*
                                    ["src" "test"])]
                        (fmt/check {:paths paths}))}
  help    {:doc "Show this help"
           :task (println "kmet - minimal coding agent\n\nTasks:\n  run           Interactive TUI (--help for options)\n  nrepl         Start nREPL server\n  test          Run fast test suites (excludes ^:slow tests; args: test names)\n  test-ext      Run ONLY slow (^:slow) test suites (args: test names; pre-commit validation)\n  check         Verify compilation\n  generate-models  Regenerate provider model catalogs from models.dev (network)\n  check-model-data Offline validation of committed provider catalogs + manifest\n  lint          Lint src/test with clj-kondo (args: files/dirs)\n  format        Format src/test with cljfmt (fix in place; args: files/dirs)\n  format-check  Check src/test formatting with cljfmt (no changes; args: files/dirs)\n\n  Changed-file dev loop (validation of the current changes only):\n  changed       List files changed since the last commit (git; mtime fallback)\n  test-changed      Run tests of namespaces affected by changed files\n  test-ext-changed  Run ONLY the slow (^:slow) tests of affected namespaces\n  lint-changed      Lint changed files plus affected dependents\n  format-changed    Format changed files in place\n  format-check-changed  Check formatting of changed files\n  changed-baseline  Reset the mtime baseline after a manual full validation (no-op with git)")
           :override-builtin true}}}
